{% extends "ws_base.html.j2" %}
{% block page_title %}{{ t("cmp.title") }}{% endblock %}
{% block content %}
<h2>{{ t("cmp.title") }}</h2>
<p class="lead">{{ t("cmp.lead") }}</p>
<div class="grid two">
  <form method="get" class="card stack">
    <label for="cmp-other">{{ t("cmp.with") }} {{ t("cmp.workspace") }}</label>
    <select id="cmp-other" name="other"><option value="">—</option>{% for w in others %}<option value="{{ w.id }}" {% if w.id == other %}selected{% endif %}>{{ w.name }}</option>{% endfor %}</select>
    <button class="btn" type="submit">{{ t("cmp.run") }}</button>
  </form>
  <form method="get" class="card stack">
    <label for="cmp-version">{{ t("cmp.with") }} {{ t("cmp.version") }}</label>
    <select id="cmp-version" name="version">{% for v in ws.versions %}<option value="{{ v.number }}" {% if v.number == version %}selected{% endif %}>v{{ v.number }} – {{ v.label }}</option>{% endfor %}</select>
    <button class="btn" type="submit">{{ t("cmp.run") }}</button>
  </form>
</div>
<form method="post" action="/w/{{ ws.id }}/compare" enctype="multipart/form-data" class="row upload-row">
  <label for="cmp-file">{{ t("cmp.upload") }}</label><input id="cmp-file" name="file" type="file" accept=".xlsx,.xlsm,.zip" required>
  <button class="btn" type="submit">{{ t("cmp.run") }}</button>
</form>
{% if result %}
<h3>{{ result.old_label }} → {{ result.new_label }}</h3>
<section class="grid tiles">
  <div class="card tile"><div class="label">{{ t("cmp.spend") }}</div><div class="value small-value">{{ money(result.old_spend) }} → {{ money(result.new_spend) }}</div></div>
  <div class="card tile"><div class="label">{{ t("cmp.cif") }}</div><div class="value small-value">{{ result.old_critical_functions }} → {{ result.new_critical_functions }}</div></div>
</section>
{% if result.is_empty %}<p>{{ t("cmp.none") }}</p>{% endif %}
<div class="table-wrap"><table>
  <thead><tr><th scope="col">Object</th><th scope="col" class="num">{{ t("cmp.added") }}</th><th scope="col" class="num">{{ t("cmp.removed") }}</th><th scope="col" class="num">{{ t("cmp.changed") }}</th></tr></thead>
  <tbody>{% for td in result.templates %}<tr><th scope="row"><a href="#d-{{ td.template | replace('.', '_') }}">{{ td.title }}</a> <span class="mono small muted">{{ td.template }}</span></th>
    <td class="num">{{ td.added | length }}</td><td class="num">{{ td.removed | length }}</td><td class="num">{{ td.changed | length }}</td></tr>{% endfor %}</tbody></table></div>
{% for td in result.templates if td.total %}
<section id="d-{{ td.template | replace('.', '_') }}" aria-labelledby="h-d-{{ loop.index }}">
  <h3 id="h-d-{{ loop.index }}">{{ td.title }} <span class="mono small muted">{{ td.template }}</span></h3>
  {% if td.added %}<h4><span class="diff-tag added">+</span> {{ t("cmp.added") }}</h4><ul class="plain">{% for k, n in td.added[:100] %}<li>{{ n }} <span class="mono small muted">{{ k }}</span></li>{% endfor %}</ul>{% endif %}
  {% if td.removed %}<h4><span class="diff-tag removed">−</span> {{ t("cmp.removed") }}</h4><ul class="plain">{% for k, n in td.removed[:100] %}<li>{{ n }} <span class="mono small muted">{{ k }}</span></li>{% endfor %}</ul>{% endif %}
  {% if td.changed %}<details><summary><span class="diff-tag changed">~</span> {{ t("cmp.changed") }} ({{ td.changed | length }})</summary>
    <div class="table-wrap"><table><thead><tr><th scope="col">Record</th><th scope="col">{{ t("cmp.field") }}</th><th scope="col">{{ t("cmp.old") }}</th><th scope="col">{{ t("cmp.new") }}</th></tr></thead>
    <tbody>{% for rc in td.changed[:200] %}{% for c in rc.changes %}<tr>{% if loop.first %}<td rowspan="{{ rc.changes | length }}">{{ rc.name }}</td>{% endif %}<td class="small">{{ c.label }}</td><td><del>{{ c.old or "—" }}</del></td><td><ins>{{ c.new or "—" }}</ins></td></tr>{% endfor %}{% endfor %}</tbody></table></div>
  </details>{% endif %}
</section>
{% endfor %}
{% else %}<p class="muted">{{ t("cmp.pick") }}</p>{% endif %}
{% endblock %}
