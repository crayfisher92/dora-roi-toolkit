{% extends "ws_base.html.j2" %}
{% block page_title %}{{ t("ex.title") }}{% endblock %}
{% block content %}
<h2>{{ t("ex.title") }}</h2>
<p class="lead">{{ t("ex.lead") }}</p>
{% if counts.error %}<div class="banner warn" role="status"><span class="icon" aria-hidden="true">!</span><div>{{ t("ex.blocked", n=counts.error) }} <a href="/w/{{ ws.id }}/fix">{{ t("ws.next.fix", n=counts.error) }}</a></div></div>{% endif %}
{% if ws.out_of_scope %}<div class="banner warn" role="status"><span class="icon" aria-hidden="true">!</span><div>{{ t("scope.export_note", n=ws.out_of_scope | length) }} <a href="/w/{{ ws.id }}/finma#h-scope">{{ t("scope.manage") }}</a></div></div>{% endif %}
<div class="grid entry">
  <section class="card entry-card"><h3>{{ t("ex.xbrl") }}</h3><p class="muted">{{ t("ex.xbrl.text") }}</p><a class="btn primary" href="/w/{{ ws.id }}/download/xbrl">{{ t("ex.download") }} (.zip)</a></section>
  <section class="card entry-card"><h3>{{ t("ex.excel") }}</h3><p class="muted">{{ t("ex.excel.text") }}</p><a class="btn primary" href="/w/{{ ws.id }}/download/xlsx">{{ t("ex.download") }} (.xlsx)</a></section>
  <section class="card entry-card"><h3>{{ t("ex.project") }}</h3><p class="muted">{{ t("ex.project.text") }}</p><a class="btn primary" href="/w/{{ ws.id }}/download/project">{{ t("ex.download") }} (.roiproj)</a>
    {% if ws.project_path %}<p class="small muted">{{ t("ex.project.autosaved", file=ws.project_path.name) }}</p>{% endif %}</section>
  <section class="card entry-card"><h3>{{ t("ex.csv") }}</h3><p class="muted">{{ t("ex.csv.text") }}</p><a class="btn" href="/w/{{ ws.id }}/download/csv">{{ t("ex.download") }} (.zip)</a></section>
  <section class="card entry-card"><h3>{{ t("ex.validation") }}</h3><p class="muted">{{ t("ex.validation.text") }}</p>
    <div class="row"><a class="btn" href="/w/{{ ws.id }}/download/validation.html" target="_blank" rel="noopener">HTML</a><a class="btn" href="/w/{{ ws.id }}/download/validation.md">Markdown</a><a class="btn" href="/w/{{ ws.id }}/download/validation.json">JSON</a>{% if pdf %}<a class="btn" href="/w/{{ ws.id }}/download/validation.pdf">PDF</a>{% endif %}</div>{% if not pdf %}<p class="muted small">{{ t("ex.pdf.unavailable") }}</p>{% endif %}</section>
  <section class="card entry-card"><h3>{{ t("ex.executive") }}</h3><p class="muted">{{ t("ex.executive.text") }}</p><div class="row"><a class="btn" href="/w/{{ ws.id }}/download/executive.html" target="_blank" rel="noopener">HTML</a>{% if pdf %}<a class="btn" href="/w/{{ ws.id }}/download/executive.pdf">PDF</a>{% endif %}</div>{% if not pdf %}<p class="muted small">{{ t("ex.pdf.unavailable") }}</p>{% endif %}</section>
</div>
{% endblock %}
