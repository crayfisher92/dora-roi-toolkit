{% extends "base.html.j2" %}
{% block title %}{{ item.name }} – DORA RoI Toolkit{% endblock %}
{% block content %}
{% set counts = report.severity_counts() %}
<header class="doc">
  <p class="eyebrow">{{ item.name }}</p>
  <h1>{{ report.maintainer_name or "Register of information" }}</h1>
  <p class="meta">{% if report.maintainer_lei %}LEI <span class="mono">{{ report.maintainer_lei }}</span> · {% endif %}
    Reference date {{ report.reference_date }} · {{ report.rules_run }} rules</p>
</header>
{% if report.passed and counts.warning == 0 %}
<div class="banner pass" role="status"><span class="icon" aria-hidden="true">✓</span><div><strong>Passed.</strong> No errors or warnings.</div></div>
{% elif report.passed %}
<div class="banner warn" role="status"><span class="icon" aria-hidden="true">!</span><div><strong>Passed with warnings.</strong> {{ counts.warning }} warning(s) to review.</div></div>
{% else %}
<div class="banner fail" role="alert"><span class="icon" aria-hidden="true">✕</span><div><strong>Not ready for submission.</strong> {{ counts.error }} error(s), {{ counts.warning }} warning(s).</div></div>
{% endif %}
<div class="row">
  <a class="btn primary" href="/r/{{ item.id }}/executive.html" target="_blank" rel="noopener">Executive summary (HTML)</a>
  <a class="btn" href="/r/{{ item.id }}/validation.html" target="_blank" rel="noopener">Validation report</a>
  <a class="btn" href="/r/{{ item.id }}/validation.json">JSON</a>
  <a class="btn" href="/r/{{ item.id }}/validation.md">Markdown</a>
  <a class="btn" href="/r/{{ item.id }}/xbrl-csv.zip" title="Best-effort xBRL-CSV package – see docs/ASSUMPTIONS.md">xBRL-CSV (best effort)</a>
</div>

<nav class="tabs" aria-label="Sections"><a href="#validation">Validation</a><a href="#dashboard">Concentration dashboard</a><a href="#functions">Critical functions</a></nav>

<section id="validation">
<h2>Validation</h2>
<section class="grid tiles">
  <div class="card tile"><div class="label"><span class="badge error">Errors</span></div><div class="value">{{ counts.error }}</div></div>
  <div class="card tile"><div class="label"><span class="badge warning">Warnings</span></div><div class="value">{{ counts.warning }}</div></div>
  <div class="card tile"><div class="label"><span class="badge info">Info</span></div><div class="value">{{ counts.info }}</div></div>
  <div class="card tile"><div class="label">Records</div><div class="value">{{ "{:,}".format(report.record_counts.values() | sum) }}</div></div>
</section>
<h3>By rule</h3>
<div class="table-wrap"><table>
  <thead><tr><th>Rule</th><th>Severity</th><th>Title</th><th class="num">Count</th></tr></thead>
  <tbody>{% for rule, n in report.by_rule() %}
  <tr><td class="mono">{{ rule.id }}</td><td><span class="badge {{ rule.severity.value }}">{{ rule.severity.value }}</span></td><td>{{ rule.title }}</td><td class="num">{{ n }}</td></tr>
  {% else %}<tr><td colspan="4" class="muted">No findings.</td></tr>{% endfor %}</tbody></table></div>
<h3>Findings</h3>
<div class="filter-row" id="filters" hidden>
  <select id="sev" aria-label="Filter by severity"><option value="">All severities</option><option value="error">Errors</option><option value="warning">Warnings</option><option value="info">Info</option></select>
  <input id="q" type="search" placeholder="Filter…" aria-label="Filter findings"><span class="muted small" id="shown"></span>
</div>
<div class="table-wrap" style="max-height:520px;overflow:auto"><table id="findings">
  <thead><tr><th>Severity</th><th>Rule</th><th>Location</th><th>Message</th></tr></thead>
  <tbody>{% for f in findings %}
  <tr data-sev="{{ f.severity.value }}"><td><span class="badge {{ f.severity.value }}">{{ f.severity.value }}</span></td>
    <td class="mono">{{ f.rule_id }}</td><td class="mono small">{{ f.location }}</td><td>{{ f.message }}{% if f.record_key %}<div class="small muted">{{ f.record_key }}</div>{% endif %}</td></tr>
  {% endfor %}</tbody></table></div>
</section>

<section id="dashboard">
<h2>Concentration dashboard</h2>
<section class="grid tiles">
  <div class="card tile"><div class="label">Annual ICT spend</div><div class="value">{{ money(a.total_spend, a.reporting_currency) }}</div><div class="sub">{{ a.totals.contracts }} arrangements</div></div>
  <div class="card tile"><div class="label">Largest provider group</div><div class="value">{{ pct(a.top1_share) }}</div><div class="sub">HHI {{ "{:,.0f}".format(a.hhi) }} · {{ a.hhi_band }}</div></div>
  <div class="card tile"><div class="label">Critical functions</div><div class="value">{{ a.totals.critical_functions }}</div><div class="sub">of {{ a.totals.functions }}</div></div>
  <div class="card tile"><div class="label">Exit plan coverage</div><div class="value">{{ pct(a.totals.exit_plan_coverage) }}</div><div class="sub">critical ICT services</div></div>
</section>
<h3>Key messages</h3>
<ul class="callouts">{% for k in a.key_findings %}<li><span class="badge {{ 'error' if k.level.value == 'high' else 'warning' if k.level.value == 'medium' else 'info' }}">{{ k.level.value }}</span> <strong>{{ k.title }}</strong> — <span class="muted">{{ k.detail }}</span></li>{% endfor %}</ul>
<div class="grid dash">
  <div class="card"><h3>Share of spend by provider group</h3>{{ charts.groups }}</div>
  <div class="card"><h3>Critical functions supported by provider group</h3>{{ charts.cif }}</div>
  <div class="card"><h3>Spend by HQ region (contracting provider)</h3>{{ charts.regions }}<h3>… and ultimate parent</h3>{{ charts.group_regions }}</div>
  <div class="card"><h3>Most frequent subcontractors</h3>{{ charts.subcontractors }}</div>
  <div class="card"><h3>Subcontracting depth</h3>{{ charts.depth }}</div>
  <div class="card"><h3>Substitutability of critical ICT services</h3>{{ charts.substitutability }}</div>
</div>
</section>

<section id="functions">
<h2>Critical functions</h2>
<div class="table-wrap"><table>
  <thead><tr><th>Function</th><th>Entity</th><th>Provider groups</th><th>Single provider</th><th>Hard to substitute</th><th class="num">Exit plans</th></tr></thead>
  <tbody>{% for f in a.critical_functions %}
  <tr><td><span class="mono small">{{ f.function_id }}</span> {{ f.function_name }}</td><td class="small">{{ f.entity_name }}</td>
    <td class="small">{{ f.provider_groups | join(", ") or "—" }}</td><td>{{ "Yes" if f.single_provider else "No" }}</td>
    <td>{{ "Yes" if f.hard_to_substitute else "No" }}</td><td class="num">{{ pct(f.exit_plan_coverage) }}</td></tr>
  {% else %}<tr><td colspan="6" class="muted">No critical functions reported.</td></tr>{% endfor %}</tbody></table></div>
</section>
{% endblock %}
{% block scripts %}
{{ tooltip_script }}
<script>
(function () {
  var f = document.getElementById("filters"); if (!f) return; f.hidden = false;
  var sev = document.getElementById("sev"), q = document.getElementById("q");
  var rows = Array.prototype.slice.call(document.querySelectorAll("#findings tbody tr"));
  var shown = document.getElementById("shown");
  function apply() {
    var s = sev.value, t = q.value.toLowerCase(), n = 0;
    rows.forEach(function (r) {
      var ok = (!s || r.dataset.sev === s) && (!t || r.textContent.toLowerCase().indexOf(t) >= 0);
      r.hidden = !ok; if (ok) n++;
    });
    shown.textContent = n + " of " + rows.length + " shown";
  }
  sev.addEventListener("change", apply); q.addEventListener("input", apply); apply();
})();
</script>
{% endblock %}
