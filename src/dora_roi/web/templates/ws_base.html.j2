{% extends "base.html.j2" %}
{% from "_macros.html.j2" import readiness_badge %}
{% block title %}{% block page_title %}{% endblock %} · {{ ws.name }} · {{ t("app.name") }}{% endblock %}
{% block subheader %}
<div class="ws-header">
  <div class="inner">
    <div class="ws-title">
      <p class="eyebrow">{{ ws.report.maintainer_name or "—" }}{% if ws.report.reference_date %} · {{ ws.report.reference_date }}{% endif %}</p>
      <h1 class="ws-name">{{ ws.name }}</h1>
    </div>
    <div class="ws-score">
      <label for="score-meter">{{ t("ws.score") }}</label>
      <div class="score-line">
        <meter id="score-meter" min="0" max="100" low="70" high="95" optimum="100" value="{{ quality.score }}" data-bind="meter">{{ quality.score }}/100</meter>
        <strong><span data-bind="score">{{ quality.score }}</span><span class="muted">/100</span></strong>
      </div>
      <div class="score-status">{{ readiness_badge(quality, t) }}
        <span class="muted small"><span data-bind="errors">{{ counts.error }}</span> {{ t("col.errors") }} · <span data-bind="warnings">{{ counts.warning }}</span> {{ t("col.warnings") }}</span></div>
    </div>
  </div>
  <nav class="inner stepper-nav" aria-label="Workflow">
    <ol class="stepper">
      {% for s in steps %}
      <li class="step {{ s.state }}">
        <a href="{{ s.href }}" {% if s.state == "current" %}aria-current="step"{% endif %}>
          <span class="num" aria-hidden="true">{% if s.state == "done" %}✓{% else %}{{ loop.index }}{% endif %}</span>
          <span class="label">{{ t("step." ~ s.key) }}</span>
          <span class="visually-hidden">({{ t("step." ~ s.state if s.state != "current" else "step.current") }})</span>
        </a>
      </li>
      {% endfor %}
    </ol>
    <ul class="subnav" role="list">
      <li><a href="/w/{{ ws.id }}" {% if path == "/w/" ~ ws.id %}aria-current="page"{% endif %}>{{ t("ws.overview") }}</a></li>
      <li><a href="/w/{{ ws.id }}/fix" {% if path.endswith("/fix") %}aria-current="page"{% endif %}>{{ t("step.fix") }}</a></li>
      <li><a href="/w/{{ ws.id }}/register" {% if "/register" in path %}aria-current="page"{% endif %}>{{ t("ws.register") }}</a></li>
      <li><a href="/w/{{ ws.id }}/analyse" {% if path.endswith("/analyse") %}aria-current="page"{% endif %}>{{ t("step.analyse") }}</a></li>
      <li><a href="/w/{{ ws.id }}/compare" {% if path.endswith("/compare") %}aria-current="page"{% endif %}>{{ t("ws.compare") }}</a></li>
      <li><a href="/w/{{ ws.id }}/export" {% if path.endswith("/export") %}aria-current="page"{% endif %}>{{ t("step.export") }}</a></li>
      <li><a href="/w/{{ ws.id }}/versions" {% if path.endswith("/versions") %}aria-current="page"{% endif %}>{{ t("ws.versions") }}</a></li>
    </ul>
    <ul class="subnav programme" role="list" aria-label="{{ t('nav.programme') }}">
      <li><a href="/w/{{ ws.id }}/contracts" {% if "/contract" in path %}aria-current="page"{% endif %}>{{ t("c30.name") }}</a></li>
      <li><a href="/w/{{ ws.id }}/incidents" {% if "/incidents" in path %}aria-current="page"{% endif %}>{{ t("inc.name") }}</a></li>
      <li><a href="/w/{{ ws.id }}/finma" {% if path.endswith("/finma") %}aria-current="page"{% endif %}>{{ t("fin.name") }}</a></li>
    </ul>
  </nav>
</div>
{% endblock %}
