/* Shared styles of the programme reports (remediation plan, incident summary, readiness). */
.section-lead { color: var(--text-secondary); max-width: 80ch; }
.pill { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 650;
  padding: 2px 9px 2px 7px; border-radius: 999px; border: 1px solid var(--border);
  background: var(--surface-2); white-space: nowrap; }
.pill::before { content: ""; width: 8px; height: 8px; border-radius: 50%; flex: none;
  background: var(--series-muted); }
.pill.high::before, .pill.red::before, .pill.missing::before, .pill.gaps::before,
.pill.major::before, .pill.overdue::before { background: var(--status-critical); }
.pill.medium::before, .pill.amber::before, .pill.partial::before, .pill.incomplete::before,
.pill.provisional::before, .pill.due::before { background: var(--status-warning); }
.pill.low::before, .pill.green::before, .pill.present::before, .pill.compliant::before,
.pill.not_major::before, .pill.done::before { background: var(--status-good); }
.rag { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  gap: 12px; }
.rag .card { border-left-width: 6px; }
.rag .red { border-left-color: var(--status-critical); }
.rag .amber { border-left-color: var(--status-warning); }
.rag .green { border-left-color: var(--status-good); }
.rag .grey { border-left-color: var(--series-muted); }
.rag h3 { margin: 0 0 4px; font-size: 15px; }
.rag .metric { font-size: 24px; font-weight: 650; }
.actions-list { padding-left: 20px; }
.actions-list li { margin-bottom: 6px; }
td.wrap, th.wrap { min-width: 220px; }
.evidence { color: var(--text-secondary); font-size: 12.5px; }
.toc { columns: 2; font-size: 14px; }
@page { size: A4; margin: 16mm 14mm; }
@media print {
  :root, :root[data-theme="dark"] { color-scheme: light; }
  body { font-size: 11.5px; }
  main { max-width: none; padding: 0; }
  h2 { break-after: avoid; page-break-after: avoid; }
  tr, .card, .tile { break-inside: avoid; page-break-inside: avoid; }
  thead { display: table-header-group; }
  th { position: static; }
  .table-wrap { overflow: visible; border: none; }
  a { color: inherit; text-decoration: none; }
  .no-print { display: none !important; }
  .page-break { break-before: page; page-break-before: always; }
}
.visually-hidden { position: absolute !important; width: 1px; height: 1px; padding: 0;
  margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.incident-detail { margin-top: 16px; }
.incident-detail h2 { margin-top: 0; }
