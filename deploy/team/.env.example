# Copy to .env and fill in (never commit .env). See docs/TEAM_DEPLOYMENT.md.
PUBLIC_HOST=roi.example.com
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=change-me
# python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=change-me
# Comma-separated e-mail domains allowed to sign in, or * for any account of the tenant
ALLOWED_EMAIL_DOMAINS=example.com
